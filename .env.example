# ============================================================
# TWILIO — telephony (places the call, carries the audio)
# ============================================================
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+12138837656

# ============================================================
# CALL TARGETS
# ============================================================
# The real test line for this assessment — do not call any other number.
TARGET_PHONE_NUMBER=+18054398008

# Your own phone — used ONLY for the Step 1 "hello world" test call,
# so we can confirm everything works before calling the real target.
MY_TEST_PHONE_NUMBER=+1XXXXXXXXXX

# ============================================================
# NGROK TUNNEL
# ============================================================
# Update this every time you restart ngrok — the free tier gives you
# a new random URL each time. No trailing slash.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# ============================================================
# AI SERVICES — not needed until Step 4 (STT/LLM/TTS pipeline)
# ============================================================
DEEPGRAM_API_KEY=your_deepgram_key_here
OPENAI_API_KEY=your_openai_key_here
CARTESIA_API_KEY=your_cartesia_key_here